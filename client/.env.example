# Set to your development machine's LAN address for a physical phone.
# Android emulator often uses http://10.0.2.2:3000; iOS simulator can use localhost.
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000

# Public contact shown in the mobile privacy screen. Replace the sample address.
EXPO_PUBLIC_CONTACT_EMAIL=contact@example.com

# Optional: set true only after providing your own licensed story media at /contents/.
EXPO_PUBLIC_PROMOTIONAL_STORIES_ENABLED=false
