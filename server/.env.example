# Copy to .env and replace all credentials and secrets with your own values.
PORT=3000
MONGODB_URI=mongodb://127.0.0.1:27017/greenride
BASE_URL=http://localhost:3000
BASE_URL_CLIENT_COMPANY=http://localhost:3001
API_TRANSCRIBE_VOSK_DOCKER_SERVER=http://localhost:5000/transcribe
EXPO_NOTIFICATION_API=https://exp.host/--/api/v2/push/send
GMAIL_EMAIL=your-account@example.com
GMAIL_PASSWORD=replace-with-an-app-password
ADMIN_GREENRIDE_EMAIL=admin@admin.com
ADMIN_GREENRIDE_PASSWORD=replace-with-a-strong-admin-password
SESSION_SECRET_PASSCODE=replace-with-a-long-random-value
COMPANY_ACTIVATION_TOKEN_SECRET_ENCODING_PASSPHRASE=replace-with-a-long-random-value
AUTH_SECRET_ENCODING_PASSPHRASE=replace-with-a-long-random-value
COMPANY_CHANGE_PASSWORD_TOKEN_SECRET_ENCODING_PASSPHRASE=replace-with-a-long-random-value
# Leave empty to use ffmpeg from PATH.
FFMPEG_PATH=
OPENROUTER_API_KEY=replace-with-your-api-key
BONUS_SELFCERTIFICATION=10
MALUS_SELFCERTIFICATION=-10
